<?xml version="1.0" encoding="utf-8"?>
<!-- Search Bar Layout XML -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nav_bg_light"
    android:elevation="4dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@drawable/search_bar_container"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_hint"
            android:tint="@color/nav_icon_inactive"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp" />

        <!-- Search EditText -->
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/nav_icon_inactive"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp" />

        <!-- Clear Button -->
        <ImageView
            android:id="@+id/clear_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/clear_search"
            android:tint="@color/nav_icon_inactive"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <!-- Filter Button -->
        <ImageView
            android:id="@+id/filter_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_filter"
            android:contentDescription="@string/filter_search"
            android:tint="@color/nav_icon_inactive"
            android:scaleType="centerInside"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</FrameLayout>